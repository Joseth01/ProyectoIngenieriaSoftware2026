# URL base del backend Laravel (API REST).
#
# Desarrollo local (navegador):   http://127.0.0.1:8000/api
# Producción / APK (Droplet):     https://TU-IP-O-DOMINIO/api
#
# IMPORTANTE: para generar el APK, copia este archivo como ".env.production"
# y pon la URL del servidor desplegado. En el celular, 127.0.0.1 es el propio
# teléfono, así que NUNCA debe quedar localhost en el build del APK.
VITE_API_URL=http://127.0.0.1:8000/api
